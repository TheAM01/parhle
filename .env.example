# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and read automatically by Next.js.

# MongoDB connection string (required).
# e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=

# Secret used to encrypt the iron-session cookie (required).
# MUST be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD=

# Set automatically by Next.js ("development" | "production"); override only if needed.
# NODE_ENV=development
